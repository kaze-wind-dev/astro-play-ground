---
import Layout from '@/layout/Layout.astro';
import PageTitle from '@/components/PageTitle.astro';
import { Image } from 'astro:assets';
import forest from '@/images/forest.jpg';
---

<Layout pageTitle="gsap">
  <PageTitle title="gsap" />
  <div class="container">
    <div class="image">
      <Image src={forest} alt="" width={1920} height={800} />
    </div>
  </div>
  
</Layout>

<style lang="scss">
  .image {
    width: 100%;
    height: 80vh;

    // clip-path: inset(30% 20% 30% 20% round 20px);
    animation: clip-path 1s ease-in-out 2s both;

    > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      animation: scale 1s ease-in-out 2s both;
    }
  }

  @keyframes clip-path {
    0% {
      // clip-path: inset(30% 20% 30% 20% round 20px);
      clip-path: inset(50% 0);
    }

    100% {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes scale {
    0% {
      transform: scale(1.2);
    }

    100% {
      transform: scale(1);
    }
  }

  // .container {
  // }
</style>

<script>
  import gsap from 'gsap';
</script>
